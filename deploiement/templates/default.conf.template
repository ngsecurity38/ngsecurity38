# Configuration minimale : des fichiers statiques, et rien d'autre.
server {
    listen 80;
    # Substitué au démarrage depuis DOMAINE (.env) par l'image nginx.
    server_name ${DOMAINE};
    root /usr/share/nginx/html;
    index index.html;

    # Le tarif et le catalogue changent sans que la page change : ils ne
    # doivent pas rester en cache, sinon un prix corrigé mettrait des jours
    # à apparaître.
    location ~* \.(json)$ {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    location / {
        try_files $uri $uri/ =404;
    }

    # La racine ne sert rien : on renvoie vers la page d'entrée.
    location = / {
        return 302 /outils/etude/;
    }
}
